{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@core/*": ["src/core/*"]
    }
  },
  "include": [
    "electron.vite.config.ts",
    "vite.web.config.ts",
    "vitest.config.ts",
    "src/shell-electron/**/*.ts",
    "src/core/**/*.ts",
    "src/core/**/*.tsx"
  ]
}
