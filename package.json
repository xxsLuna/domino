{
  "name": "domino",
  "version": "0.1.0",
  "description": "domino: open .domino files and let an LLM generate the app UI in real time",
  "main": "out/main/index.js",
  "private": true,
  "build": {
    "appId": "ui.domino.runtime",
    "productName": "domino",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dev:web": "vite --config vite.web.config.ts",
    "mock": "node samples/mock-server.mjs",
    "build:web": "vite build --config vite.web.config.ts",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --publish never",
    "android:sync": "npm run build:web && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@gravity-ui/icons": "^2.23.0",
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@internationalized/date": "^3.12.4",
    "@react-aria/ssr": "^3.10.1",
    "@react-aria/utils": "^3.34.1",
    "react": "^19.1.0",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.0",
    "vite": "^6.0.0",
    "vitest": "^3.1.0"
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "esbuild@0.25.12": true
  }
}
